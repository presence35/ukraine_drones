<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: black background with the static trident, so the
         startup reads trident -> animated trident instead of the drone launcher icon. -->
    <style name="Theme.UkraineDrones" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_trident</item>
    </style>
</resources>
